NEXT_PUBLIC_API_URL=http://localhost:8000

# E2E 테스트 전용 인증 훅 (FRT-24)
# true로 설정하면 fetchCurrentUser()가 로그인 플로우 없이 고정 사용자를 반환해
# (main) 진입을 E2E에서 검증할 수 있다. 기본값은 off이며, production/preview에는 설정하지 않는다.
NEXT_PUBLIC_E2E_AUTH=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog 분석 (FRT-18) — Cloud EU(Frankfurt)
# KEY 는 phc_ 로 시작하는 공개(write-only) 프로젝트 키라 프론트 노출 안전.
# 미설정 시 분석은 초기화되지 않는다(개발·CI·E2E 격리). HOST 는 EU 수집 호스트.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
