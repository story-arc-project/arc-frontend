NEXT_PUBLIC_API_URL=http://localhost:8000

# E2E 테스트 전용 인증 훅 (FRT-24)
# true로 설정하면 fetchCurrentUser()가 로그인 플로우 없이 고정 사용자를 반환해
# (main) 진입을 E2E에서 검증할 수 있다. 기본값은 off이며, production/preview에는 설정하지 않는다.
NEXT_PUBLIC_E2E_AUTH=

# Admin 영역 접근 allowlist (FRT-15)
# 콤마로 구분한 관리자 이메일 목록. 여기 포함된 계정만 /admin 에 접근할 수 있다.
# ⚠️ 서버 전용 — NEXT_PUBLIC_ 접두사 금지(클라이언트 번들에 노출되면 운영자 이메일이 샌다).
# 미설정 시 누구도 admin 이 아니다(fail-closed). 보안 본체는 백엔드 인가이고 이건 UX+추가 방어막이다.
# ⚠️ 배포 요건: 서버사이드 admin 가드가 auth 쿠키를 백엔드로 forward 하려면, 그 쿠키가
#    프론트 도메인에서 보여야 한다(백엔드와 공유 상위 도메인, 예: `.story-arc.org`).
#    쿠키가 백엔드 host-only 로 스코프되면 서버가 이를 못 봐 admin 이 항상 404 가 된다.
# 예: ADMIN_EMAILS=ops1@story-arc.org,ops2@story-arc.org
#
# 🔁 이 목록은 분석 제외에도 쓰인다 (FRT-139) — 여기 있는 계정은 PostHog person 에
#    `$internal_or_test_user=true` 가 붙어 내부/테스트 사용자 필터에 걸린다. 팀원이 늘면
#    코드가 아니라 이 값만 고치면 된다(재배포는 필요 — NEXT_PUBLIC_ 이 아니라 서버 런타임 값).
ADMIN_EMAILS=

# Admin 고객 목록·검색 노출 플래그 (FRT-16)
# 백엔드 GET /admin/customers(BAC-16)가 아직 미배포라 기본 off — off 면 /admin/customers 는
# "준비 중" placeholder 를 유지한다. 백엔드가 배포되면 이 값을 true 로 켜 실제 목록을 연다.
NEXT_PUBLIC_ADMIN_CUSTOMERS_ENABLED=

# PostHog 분석 (FRT-18) — Cloud EU(Frankfurt)
# KEY 는 phc_ 로 시작하는 공개(write-only) 프로젝트 키라 프론트 노출 안전.
# 미설정 시 분석은 초기화되지 않는다(개발·CI·E2E 격리). HOST 는 EU 수집 호스트.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
